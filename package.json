{
  "name": "quiz-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:check": "dotenv -e .env.local -- tsx scripts/assert-not-prod.ts",
    "db:migrate": "npm run db:check && dotenv -e .env.local -- prisma migrate deploy",
    "db:migrate:dev": "npm run db:check && dotenv -e .env.local -- prisma migrate dev",
    "db:status": "dotenv -e .env.local -- prisma migrate status",
    "db:seed": "dotenv -e .env.local -- tsx prisma/seed.ts",
    "db:seed:dev": "dotenv -e .env.local -v SEED_ALLOW_UNREVIEWED=1 -- tsx prisma/seed.ts",
    "db:studio": "npm run db:check && dotenv -e .env.local -- prisma studio",
    "db:verify": "dotenv -e .env.local -- tsx scripts/verify-db.ts",
    "test:integration": "vitest run -c vitest.integration.config.mts",
    "logo:build": "node scripts/generate-logo-assets.mjs",
    "test:e2e": "npm run db:check && playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@prisma/client": "^6.19.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.70.0",
    "next": "15.5.29",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
