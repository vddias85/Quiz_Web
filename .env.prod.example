# Modelo do .env.prod.local: valores do projeto quiz-web-PROD, usados SÓ pelos comandos npm run db:prod:*
# e check:rls:prod, rodados por você no seu computador. O .env.prod.local nunca vai para o Git.
# Copie este arquivo para .env.prod.local e preencha.

# Conexão via pooler (porta 6543), igual ao dev, mas do projeto prod.
# Supabase (prod) → Connect → "Transaction pooler". Acrescente no fim: ?pgbouncer=true&connection_limit=1
DATABASE_URL=

# Conexão direta (porta 5432): migrações, seed, verificação e backup.
# Supabase (prod) → Connect → "Direct connection" (ou "Session pooler", porta 5432, se a rede não tiver IPv6).
DIRECT_URL=

# Project ref do quiz-web-PROD (20 letras, aparece na URL do painel). O mesmo do .env.local.
PROD_PROJECT_REF=

# Para a conferência do RLS (npm run check:rls:prod).
# SUPABASE_URL: pode ficar em branco (o endereço é montado a partir do project ref das conexões).
# SUPABASE_ANON_KEY: Supabase (prod) → Project Settings → API Keys → chave "publishable" (ou "anon").
# É a chave pública, NUNCA a secret / service_role.
SUPABASE_URL=
SUPABASE_ANON_KEY=
