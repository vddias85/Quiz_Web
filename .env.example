# Copie este arquivo para .env.local e preencha com os valores do projeto quiz-web-DEV.
# .env.local nunca vai para o Git. Nunca coloque aqui valores do projeto prod.

# Conexão via pooler (porta 6543): usada pela aplicação.
# Supabase → Connect → "Transaction pooler". O final deve ficar exatamente: ?pgbouncer=true&connection_limit=1
# (o Supabase já entrega com ?pgbouncer=true: nesse caso, acrescente só &connection_limit=1)
DATABASE_URL=

# Conexão direta (porta 5432): usada só pelo Prisma para migrações e seed.
# Supabase → Connect → "Direct connection" (ou "Session pooler", porta 5432, se a rede não tiver IPv6).
DIRECT_URL=

# Texto aleatório longo (mínimo 32 caracteres) para assinar o cookie do jogador.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Project ref do quiz-web-PROD (20 letras, aparece na URL do painel).
# Usado para bloquear testes e seed contra produção. Não é a URL nem a senha.
PROD_PROJECT_REF=
